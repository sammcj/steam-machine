[Unit]
Description=Restore input-remapper's system files after a SteamOS update
Documentation=file:///home/deck/git/steam-machine/system/input-remapper/README.md
# The application itself lives in /opt/input-remapper, which is a SteamOS
# offload mount on the home partition and survives A/B updates untouched. What
# does NOT survive is the handful of system-side files that have to exist
# outside /opt:
#
#   /usr/bin/input-remapper-*            pkexec and udev resolve these by name
#   /usr/share/input-remapper            DATA_DIR is hardcoded in the source
#   /usr/share/polkit-1/actions/...      polkit reads actions from /usr only
#   /etc/dbus-1/system.d/...             not on the atomic-update keep list
#   /etc/udev/rules.d/...                not on the keep list either
#
# --boot reinstalls whichever of those are missing or modified, and rebuilds
# the venv if SteamOS moved the system python to a new minor version (the venv
# is --system-site-packages, so it borrows evdev/PyGObject/cairo from /usr and
# breaks silently if that tree is renamed).
After=local-fs.target
Wants=local-fs.target
# Ordered before the daemon only. NOT before systemd-user-sessions.service:
# this unit can wait on the repo-wide rootfs lock, and holding up graphical
# login for that is a black screen on a TV with no explanation, on exactly the
# boot after an OS update.
Before=input-remapper.service
# The venv rebuild wants a route for pip. Best effort -- do_boot restores the
# system files first and treats a failed rebuild as a warning, so this only
# improves the odds of the rebuild succeeding on the first try.
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/home/deck/git/steam-machine/system/input-remapper/install.sh --boot
# A venv rebuild after a python bump downloads nothing but wheels; allow for
# it. Deliberately longer than lib/rootfs.sh's 600s rootfs-lock wait, so a unit
# that waits out the lock is not then killed while holding it.
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target

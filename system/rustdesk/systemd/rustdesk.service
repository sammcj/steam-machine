[Unit]
Description=RustDesk (LAN-only unattended remote desktop)
Documentation=file:///home/deck/git/steam-machine/system/rustdesk/README.md
# Upstream's unit, with two additions: the ExecStartPre self-heal below, and
# ordering after NetworkManager so the firewall rules have a live interface to
# scope themselves to.
Requires=network.target
# network-online.target, not just NetworkManager.service: the latter is satisfied
# once the daemon is running, which on this machine is ~3 s before enp9s0 gets
# carrier. Starting that early left lan_cidrs() with no addresses and no routes,
# so ExecStartPre died and the whole service failed the boot -- silently, since a
# failed unit is not something anyone looks at until remote access is needed.
# NetworkManager-wait-online.service is enabled here, so this target is real.
Wants=network-online.target
After=systemd-user-sessions.service NetworkManager.service network-online.target firewalld.service

# No [Install] section, deliberately. This unit must never start at boot: in
# Game Mode RustDesk cannot capture anything and burns 80% of a core probing for
# a session it will never find (measured 2026-08-14 -- see bin/rustdesk-in-
# desktop-mode for the numbers and the mechanism). It is started by
# rustdesk-desktop-mode.service, a *user* unit wanted by plasma-workspace.target,
# so it comes up with Desktop Mode and stops with it.
#
# Removing [Install] rather than just leaving the unit disabled is the point:
# `systemctl enable rustdesk` now fails loudly instead of quietly reinstating
# the boot-time start that this subsystem exists to prevent.

[Service]
Type=simple

# The Game Mode gate. A failing ExecCondition marks the unit skipped rather
# than failed, so a stray start costs one exec and no journal noise -- and,
# importantly, does not trip Restart=on-failure below.
#
# This is the backstop, not the gate: the user unit above is what ties the
# lifetime to Desktop Mode. This catches a manual `systemctl start rustdesk`
# typed in Game Mode, and the window during a mode switch where the user
# manager has queued the start but the Plasma session is already going away.
ExecCondition=/home/deck/git/steam-machine/system/rustdesk/bin/rustdesk-in-desktop-mode
# Ordering above is necessary but not sufficient -- IPv6 RA can arrive after
# network-online.target is reached. Combined with the bounded wait in --boot,
# this turns a lost race into a delay rather than a dead service until reboot.
Restart=on-failure
RestartSec=10s

# SteamOS A/B updates replace the whole /usr tree, taking /usr/bin/rustdesk and
# /usr/share/rustdesk with them. This unit survives -- /etc/systemd/system is on
# the keep list -- so without this the unit would come back pointing at a binary
# that no longer exists. Restores from the package cached under /home, which no
# update touches. Also re-applies the firewalld rules, which are runtime-only.
#
# It must NOT be prefixed with `-`: if the binary could not be restored there is
# nothing to run, and failing loudly here beats a confusing ExecStart error.
#
# Since the Game Mode gate above, this runs on entry to Desktop Mode rather than
# at boot. That is strictly better: the restore happens at the only moment the
# binary is about to be used, instead of on every boot into a mode that cannot
# use it. It also means a first Desktop Mode entry after an OS update costs the
# extract -- hence --no-block on the user unit's ExecStart.
ExecStartPre=/home/deck/git/steam-machine/system/rustdesk/install.sh --boot

# --service is the root supervisor. It does not capture anything itself: it
# watches seat0 via loginctl and spawns a --server child per desktop session as
# that session's user, passing DISPLAY/WAYLAND_DISPLAY/XAUTHORITY/DBUS through.
ExecStart=/usr/bin/rustdesk --service
# Upstream's own comment: this kills --tray and --server both. The two narrower
# pkill lines they tried first did not work.
ExecStop=pkill -f "rustdesk --"
PIDFile=/run/rustdesk.pid
KillMode=mixed
TimeoutStopSec=30
User=root
LimitNOFILE=100000
Environment="PULSE_LATENCY_MSEC=60" "PIPEWIRE_LATENCY=1024/48000"

# Not set, deliberately: RUSTDESK_FORCED_DISPLAY_SERVER.
# get_display_server() asks `loginctl show-session <seat0 active> -p Type`
# first, and on this machine that answers `wayland` in both Game Mode and
# Desktop Mode -- so RustDesk already picks the PipeWire/portal capture path
# and the override would only be a way to get it wrong. If capture ever comes
# back black, `Environment="RUSTDESK_FORCED_DISPLAY_SERVER=wayland"` is the one
# lever that exists (it is one of only two RUSTDESK_* vars in the whole tree).
# Note is_x11() is a lazy_static, evaluated once per --server process, so any
# change needs a service restart, not just a reconnect.

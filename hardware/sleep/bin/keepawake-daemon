#!/usr/bin/env bash
# Holds a logind block inhibitor on `sleep` for as long as an SSH session
# exists, plus a grace window after the last one goes away.
#
# Run as root from steam-machine-keepawake.service. Root matters: logind
# short-circuits its polkit check when the caller's uid matches its own, so a
# root caller never hits the auth_admin_keep default on
# org.freedesktop.login1.inhibit-block-sleep. A non-root daemon would need the
# polkit rule this subsystem also installs (that rule exists for the
# interactive `keepawake` shell function, not for this).
#
# This script does NOT hold the inhibitor itself. It starts and stops
# steam-machine-sleep-inhibit.service, so systemd owns the lifetime of the
# inhibiting process:
#
#   - `systemd-inhibit` holds the lock for exactly as long as the process it
#     spawns lives. Killing systemd-inhibit directly would orphan that child
#     and leave a `sleep infinity` running forever.
#   - systemd's default KillMode=control-group tears down the whole cgroup on
#     stop, so the lock cannot be leaked and the child cannot be orphaned.
#   - If this daemon dies, the unit's ExecStopPost stops the inhibit unit, so a
#     crash releases the lock rather than wedging the machine permanently awake.
set -euo pipefail

# Seconds to keep holding after the last SSH session disappears. Set from the
# unit file; see the comment there for why the default is what it is.
WINDOW="${KEEPAWAKE_WINDOW:-7200}"
POLL="${KEEPAWAKE_POLL:-60}"

INHIBIT_UNIT="steam-machine-sleep-inhibit.service"

log() { printf 'keepawake: %s\n' "$*"; }

# Count logind sessions registered by sshd.
#
# `loginctl list-sessions` has no column for the registering service, so each
# session id is queried individually. There are only ever a handful of sessions
# on this box and this runs once a minute, so the fork cost is irrelevant.
#
# Matching on Service=sshd rather than Remote=yes is deliberate: Remote is also
# true for other remote logins, while Service names exactly what we care about.
ssh_session_count() {
    local id n=0
    while read -r id _; do
        [[ -n "$id" ]] || continue
        if [[ "$(loginctl show-session "$id" -p Service --value 2>/dev/null)" == "sshd" ]]; then
            n=$((n + 1))
        fi
    done < <(loginctl list-sessions --no-legend 2>/dev/null || true)
    printf '%s' "$n"
}

inhibiting() { systemctl is-active --quiet "$INHIBIT_UNIT"; }

main() {
    local last_seen=0 now count

    # A previous run may have been killed hard, leaving the inhibit unit up.
    # Start from a known state rather than inheriting a stale lock.
    systemctl stop "$INHIBIT_UNIT" >/dev/null 2>&1 || true

    log "started (window=${WINDOW}s poll=${POLL}s)"

    while :; do
        count="$(ssh_session_count)"
        now="$(date +%s)"
        [[ "$count" -gt 0 ]] && last_seen="$now"

        # Hold while a session exists, OR while still inside the grace window
        # after the last one. The first clause is not redundant: with
        # KEEPAWAKE_WINDOW=0 the second is never true, and without it the
        # daemon would refuse to hold even with someone actively logged in.
        if [[ "$count" -gt 0 ]] \
            || { [[ "$last_seen" -gt 0 ]] && [[ $((now - last_seen)) -lt "$WINDOW" ]]; }; then
            if ! inhibiting; then
                systemctl start "$INHIBIT_UNIT"
                log "sleep inhibited ($count ssh session(s))"
            fi
        else
            if inhibiting; then
                systemctl stop "$INHIBIT_UNIT"
                log "sleep released (no ssh session for ${WINDOW}s)"
            fi
        fi

        sleep "$POLL"
    done
}

main "$@"

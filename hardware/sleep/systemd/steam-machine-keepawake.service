[Unit]
Description=Prevent system sleep while an SSH session is active
Documentation=file:///home/deck/git/steam-machine/hardware/sleep/README.md
After=systemd-logind.service local-fs.target
Wants=systemd-logind.service

[Service]
Type=exec

# How long to keep the machine awake after the LAST SSH session ends. Sessions
# that are still open always count, so this is a tail, not a total.
#
# This tail only works if dead sessions actually get reaped -- a laptop that
# suspends or drops off Wi-Fi would otherwise leave an sshd session registered
# with logind indefinitely, and the machine would never sleep again. That is
# what ClientAliveInterval in system/ssh/ is for; the two are a pair.
Environment=KEEPAWAKE_WINDOW=7200
Environment=KEEPAWAKE_POLL=60

# Self-heal before doing any work: the polkit rule this subsystem installs
# lives in /etc/polkit-1/rules.d, which is NOT on the SteamOS keep list and is
# silently dropped by an A/B update. `-` so a failure here can never stop the
# daemon starting -- the daemon itself runs as root and does not need the rule.
ExecStartPre=-/home/deck/git/steam-machine/hardware/sleep/install.sh --boot
ExecStart=/home/deck/git/steam-machine/hardware/sleep/bin/keepawake-daemon

# Release the lock if the daemon stops for any reason. Without this, a crash
# would leave the inhibit unit running and the machine awake forever with
# nothing left to notice.
ExecStopPost=-/usr/bin/systemctl stop steam-machine-sleep-inhibit.service

Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target

// Let `deck` take a block inhibitor on sleep without authenticating.
//
// systemd's shipped policy (/usr/share/polkit-1/actions/org.freedesktop.login1.policy)
// declares:
//
//     org.freedesktop.login1.inhibit-block-sleep
//         allow_any=auth_admin_keep   allow_inactive=yes   allow_active=yes
//
// An SSH session is neither "active" nor "inactive" as far as polkit is
// concerned -- both of those describe sessions attached to a local seat. A
// remote shell therefore falls through to allow_any and gets an interactive
// password prompt. Measured on this machine:
//
//     $ systemd-inhibit --what=sleep --mode=block ... sleep 5
//     Failed to inhibit: Interactive authentication required.
//     $ busctl call ... login1.Manager CanSuspend
//     s "challenge"
//
// From a plain SSH terminal that prompt is merely annoying; from any non-TTY
// context (a script, a hook, an agent shelling out) it hangs forever, because
// sudo/polkit writes the prompt but there is no terminal to answer it on.
//
// org.freedesktop.login1.inhibit-block-idle is already allow_any=yes upstream
// and needs no rule here -- but it is also useless on its own, since logind's
// IdleAction is unset on this box and the suspend actually comes from Steam
// calling Manager.Suspend directly.
//
// Scope: deck is the only login user on this machine and is already in wheel,
// so being able to stop the machine sleeping is not a meaningful escalation --
// the same user can already run `sudo systemctl suspend` in the other
// direction. The rule is deliberately narrow: one action, one user, no
// wildcards.
polkit.addRule(function (action, subject) {
    if (action.id === "org.freedesktop.login1.inhibit-block-sleep" &&
        subject.user === "deck") {
        return polkit.Result.YES;
    }
});

[Unit]
Description=Shift+Esc hotkey to re-detect the TV
Documentation=file:///home/deck/git/steam-machine/hardware/display/README.md
# The manual escape hatch, and the only trigger that works no matter what the
# screen is currently doing. Reads evdev directly so it covers Game Mode,
# Desktop Mode and a bare TTY alike -- see the daemon's docstring for the
# (deliberately narrow) scope of what it inspects.
After=local-fs.target
RequiresMountsFor=/home/deck

[Service]
Type=simple
ExecStart=/home/deck/git/steam-machine/hardware/display/bin/display-hotkey-daemon
Restart=always
RestartSec=5
# It needs root for /dev/input and debugfs, but nothing beyond that.
NoNewPrivileges=yes
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/run
PrivateNetwork=yes

[Install]
WantedBy=multi-user.target

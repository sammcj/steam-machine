# Generated by hardware/kernel/install.sh -- do not edit in place, edit the
# template in the repo. @UUID@ is substituted with the running slot's rootfs
# UUID at install time, because an A/B update can land the machine on the other
# slot with a different UUID.
#
# Sourced by /etc/grub.d/41_custom at the END of the generated grub.cfg. That
# ordering is the whole trick:
#
#   * SteamOS's "steamenv header sub block" hardcodes `timeout=0` near the top
#     and ignores GRUB_TIMEOUT entirely, so no /etc/default/grub.d drop-in can
#     raise it. Setting it here runs last and wins.
#
#   * The FRL kernel lives in /boot/frl/, which GRUB's 10_linux never globs, so
#     grub.cfg itself is byte-for-byte stock. The entire FRL boot path is this
#     one file. If it goes missing -- which is exactly what a SteamOS A/B update
#     does to the EFI partition -- GRUB falls straight through to stock
#     behaviour and boots the Valve kernel. The TV is this machine's only
#     console, so that failure mode is the point.

set timeout=10
set timeout_style=menu

menuentry 'SteamOS -- 4K120 HDMI (mainline kernel, HDMI 2.1 FRL)' --class steamos --class gnu-linux --class gnu --class os --id @MENU_ID@ {
	load_video
	set gfxpayload=$linux_gfx_mode
	insmod steamenv
	insmod gzio
	insmod part_gpt
	insmod btrfs
	search --no-floppy --fs-uuid --set=root @UUID@
	steamenv_boot	linux /boot/frl/vmlinuz-linux-frlprobe console=tty1 rd.luks=0 rd.lvm=0 rd.md=0 rd.dm=0 rd.systemd.gpt_auto=no acpi_enforce_resources=lax log_buf_len=4M amd_iommu=off amdgpu.lockup_timeout=5000,10000,10000,5000 ttm.pages_min=2097152 amdgpu.sched_hw_submission=4 amdgpu.dcdebugmask=0x20000 amdgpu.dcfeaturemask=0x402 audit=0 fsck.mode=auto fsck.repair=preen
	initrd	/boot/amd-ucode.img /boot/frl/initramfs-linux-frlprobe.img
}

# Boot this by default, but only when GRUB has not been handed a one-shot
# target. 00_header consumes `next_entry` into `default` and sets `boot_once`,
# so honouring boot_once keeps `grub-reboot` working -- which is the documented
# way to make a single attempt at a different entry without changing the
# default.
#
# amdgpu.dcfeaturemask=0x402 above appears ONLY on this entry. Setting it via
# GRUB_CMDLINE_LINUX would inject it into the stock Valve entries too, changing
# how the fallback kernel boots. It must stay isolated here.
#
# DC_FRL_MASK is (1 << 10) = 0x400, and dcfeaturemask REPLACES rather than ORs,
# so the driver default DC_MULTI_MON_PP_MCLK_SWITCH_MASK (0x2) has to be carried
# explicitly: 0x400 | 0x2 = 0x402.
if [ -z "${boot_once}" ]; then
  set default="@MENU_ID@"
fi

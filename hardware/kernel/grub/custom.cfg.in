# Generated by hardware/kernel/install.sh -- do not edit in place, edit the
# template in the repo. The UUID placeholder below is substituted with the
# running slot's rootfs UUID at install time, because an A/B update can land the
# machine on the other slot with a different UUID.
#
# Sourced by /etc/grub.d/41_custom at the END of the generated grub.cfg. That
# ordering is the whole trick:
#
#   * SteamOS's "steamenv header sub block" hardcodes `timeout=0` near the top
#     and ignores GRUB_TIMEOUT entirely, so no /etc/default/grub.d drop-in can
#     raise it. Setting it here runs last and wins.
#
#   * The FRL kernel lives in /boot/frl/, which GRUB's 10_linux never globs, so
#     grub.cfg itself is byte-for-byte stock. The entire FRL boot path is this
#     one file. If it goes missing -- which is exactly what a SteamOS A/B update
#     does to the EFI partition -- GRUB falls straight through to stock
#     behaviour and boots the Valve kernel. The TV is this machine's only
#     console, so that failure mode is the point.

set timeout=10
set timeout_style=menu

menuentry 'SteamOS -- 4K120 HDMI (mainline kernel, HDMI 2.1 FRL)' --class steamos --class gnu-linux --class gnu --class os --id @MENU_ID@ {
	load_video
	set gfxpayload=$linux_gfx_mode
	insmod steamenv
	insmod gzio
	insmod part_gpt
	insmod btrfs
	search --no-floppy --fs-uuid --set=root @UUID@
	steamenv_boot	linux /boot/frl/vmlinuz-linux-frlprobe console=tty1 rd.luks=0 rd.lvm=0 rd.md=0 rd.dm=0 rd.systemd.gpt_auto=no acpi_enforce_resources=lax log_buf_len=4M amd_iommu=off amdgpu.lockup_timeout=5000,10000,10000,5000 amdgpu.sched_hw_submission=4 amdgpu.dcdebugmask=0x20000 amdgpu.dcfeaturemask=0x402 audit=0 fsck.mode=auto fsck.repair=preen
	initrd	/boot/amd-ucode.img /boot/frl/initramfs-linux-frlprobe.img
}

# The preset builds a second initramfs, and it is worth knowing exactly what it
# is here: a byte-identical COPY of the default one, not a superset.
#
# `fallback_options="-S autodetect"` skips the autodetect hook, which on a normal
# Arch box is what makes the fallback image carry every module rather than only
# the ones in use. SteamOS drops in /etc/mkinitcpio.conf.d/20-steamdeck.conf,
# which REPLACES HOOKS with a list that has no `autodetect` in it -- so the
# default image already contains everything and -S skips a hook that never ran.
# Verified by md5: both images match.
#
# That still leaves it useful, just for a different reason than usual: it is a
# second physical copy, so a truncated or corrupted default image (an interrupted
# mkinitcpio, a full /boot) has something to fall back to. It is not insurance
# against a missing module.
menuentry 'SteamOS -- 4K120 HDMI (mainline kernel, fallback initramfs)' --class steamos --class gnu-linux --class gnu --class os --id @MENU_ID@-fallback {
	load_video
	set gfxpayload=$linux_gfx_mode
	insmod steamenv
	insmod gzio
	insmod part_gpt
	insmod btrfs
	search --no-floppy --fs-uuid --set=root @UUID@
	steamenv_boot	linux /boot/frl/vmlinuz-linux-frlprobe console=tty1 rd.luks=0 rd.lvm=0 rd.md=0 rd.dm=0 rd.systemd.gpt_auto=no acpi_enforce_resources=lax log_buf_len=4M amd_iommu=off amdgpu.lockup_timeout=5000,10000,10000,5000 amdgpu.sched_hw_submission=4 amdgpu.dcdebugmask=0x20000 amdgpu.dcfeaturemask=0x402 audit=0 fsck.mode=auto fsck.repair=preen
	initrd	/boot/amd-ucode.img /boot/frl/initramfs-linux-frlprobe-fallback.img
}

# Boot this by default, but only when GRUB has not been handed a one-shot
# target. 00_header consumes `next_entry` into `default` and sets `boot_once`,
# so honouring boot_once is the correct thing to do here.
#
# `grub-reboot` still does not work here, but not for the reason first assumed.
# 00_header guards it with `if [ -s $prefix/grubenv ]` and no grubenv exists on
# this ESP, so creating one with `grub-editenv create` and setting `next_entry`
# looked like the fix. It did not take: `next_entry` was still set after the
# next boot, so GRUB never consumed it.
#
# That boot also hung at a blank screen after the firmware logo, which was
# blamed on the grubenv at the time. **That was wrong.** The same blank-screen
# boot happened again later with no grubenv present at all. It correlates with
# the preceding forced power-off (the 4-second hold used to escape the S5 hang),
# not with anything in this file -- two for two, and it clears on a second power
# cycle. See ../README.md under "OPEN: power-off hangs".
#
# To boot the stock Valve kernel once, just pick it in the menu -- the timeout
# below is 10 seconds precisely so that is possible.
#
# amdgpu.dcfeaturemask=0x402 above appears ONLY on this entry. Setting it via
# GRUB_CMDLINE_LINUX would inject it into the stock Valve entries too, changing
# how the fallback kernel boots. It must stay isolated here.
#
# DC_FRL_MASK is (1 << 10) = 0x400, and dcfeaturemask REPLACES rather than ORs,
# so the driver default DC_MULTI_MON_PP_MCLK_SWITCH_MASK (0x2) has to be carried
# explicitly: 0x400 | 0x2 = 0x402.
#
# The rest of the command line is Valve's stock one, minus ttm.pages_min=2097152:
# that is a Valve-only ttm parameter, and mainline logs
# `ttm: unknown parameter 'pages_min' ignored` for it. Harmless either way, but
# an ignored parameter in a boot line is a trap for whoever debugs this next.
# Check `dmesg | grep 'unknown parameter'` after any future rebase.
# Only default to the FRL entry if the kernel it names is actually there, on a
# filesystem GRUB can actually find.
#
# Added 2026-08-28, after a SteamOS update landed the machine on the other A/B
# slot: this file survived with the OLD slot's rootfs UUID, so `search` found no
# device, the entry could not load its kernel, and GRUB stopped at
# "Failed to boot both default and fallback entries. Press any key to continue"
# -- an outage on a machine whose only console is a TV. `fallback` did not save
# it, so do not rely on it: probe first, and simply do not claim the default
# when the entry cannot work. A stale or half-installed FRL install then boots
# stock SteamOS silently, and the next boot's self-heal repairs it.
#
# Both files are checked with -s rather than -e: an interrupted install (a
# rootfs that went read-only mid-extraction, a full /boot) leaves a truncated
# or zero-length image, which -e would happily accept.
set frlroot=
search --no-floppy --fs-uuid --set=frlroot @UUID@
if [ -n "${frlroot}" ]; then
  if [ -s ($frlroot)/boot/frl/vmlinuz-linux-frlprobe ]; then
    if [ -s ($frlroot)/boot/frl/initramfs-linux-frlprobe.img ]; then
      if [ -z "${boot_once}" ]; then
        set default="@MENU_ID@"
      fi
    fi
  fi
fi

# If the default entry cannot be loaded -- kernel file missing after a partial
# install or an interrupted uninstall -- GRUB prints an error and waits for a
# keypress with no timeout. On a machine whose only console is the TV that is an
# outage. `fallback` turns every such state into an automatic stock boot.
#
# By id first, since 10_linux names the top-level SteamOS entry after the rootfs
# UUID, then by index 0 in case a future grub.cfg drops the id.
set fallback="gnulinux-simple-@UUID@ 0"

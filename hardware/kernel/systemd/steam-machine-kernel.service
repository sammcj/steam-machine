[Unit]
Description=Reinstall the HDMI 2.1 FRL kernel if a SteamOS update removed it
Documentation=file:///home/deck/git/steam-machine/hardware/kernel/README.md
# /home holds both the repo and the cached kernel tarball, so nothing can run
# before it is mounted.
RequiresMountsFor=/home /boot /efi
After=local-fs.target
ConditionPathExists=/home/deck/git/steam-machine/hardware/kernel/install.sh

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/home/deck/git/steam-machine/hardware/kernel/install.sh --boot
# Restoring ~180 MB of modules and running mkinitcpio twice takes a while on a
# cold cache; the default 90s is not enough.
TimeoutStartSec=600
# No SuccessExitStatus override. A failing oneshot wanted by multi-user.target
# does not block boot on its own -- the machine is on the stock Valve kernel at
# this point and stays usable without the FRL one -- so mapping install.sh's
# exit 1 onto success bought nothing and cost the only signal there is: the
# README tells you to check `systemctl status` when the repair did not happen,
# and with the override that check was green even on a full-rootfs failure.

[Install]
WantedBy=multi-user.target
